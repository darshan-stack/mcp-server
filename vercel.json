{
  "$schema": "https://vercel.schema/vercel.json",
  "outputDirectory": "dist/public",
  "framework": null,
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}