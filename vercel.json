{
  "$schema": "https://vercel.schema/vercel.json",
  "outputDirectory": "dist/public",
  "framework": null,
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.cjs" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
